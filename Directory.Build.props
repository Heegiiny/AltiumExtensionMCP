<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Environment-specific paths live in Environment.local.props (git-ignored), generated by
    tools\Detect-AltiumEnvironment.ps1 from the Altium registry entries. See docs/ENVIRONMENT.md.
    Anything can still be overridden on the command line, e.g.
      dotnet build -p:AltiumProfileGuid="{...}" -p:AltiumProgramsHome="C:\Program Files\Altium\AD26"
    Precedence: command line / environment variables > Environment.local.props > defaults below.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Environment.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Environment.local.props')" />

  <PropertyGroup>
    <!-- Primary knobs (normally supplied by Environment.local.props). -->
    <AltiumProgramsHome Condition="'$(AltiumProgramsHome)' == ''">C:\Program Files\Altium\AD26</AltiumProgramsHome>
    <AltiumProfileGuid Condition="'$(AltiumProfileGuid)' == ''"></AltiumProfileGuid>
    <AltiumProfileRoot Condition="'$(AltiumProfileRoot)' == '' and '$(AltiumProfileGuid)' != ''">C:\ProgramData\Altium\Altium Designer $(AltiumProfileGuid)</AltiumProfileRoot>

    <!-- Derived paths. -->
    <AltiumExe Condition="'$(AltiumExe)' == ''">$(AltiumProgramsHome)\X2.EXE</AltiumExe>
    <AltiumSystemHome Condition="'$(AltiumSystemHome)' == ''">$(AltiumProgramsHome)\System</AltiumSystemHome>
    <AltiumSdkHome Condition="'$(AltiumSdkHome)' == '' and '$(AltiumProfileRoot)' != ''">$(AltiumProfileRoot)\Extensions\Altium Developer\SDK25</AltiumSdkHome>
    <!-- Where the extension is deployed (Altium loads it from here). -->
    <AltiumExtensionDeployDir Condition="'$(AltiumExtensionDeployDir)' == '' and '$(AltiumProfileRoot)' != ''">$(AltiumProfileRoot)\Extensions\AltiumExtensionMCP</AltiumExtensionDeployDir>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.1.0</Version>
  </PropertyGroup>
</Project>
