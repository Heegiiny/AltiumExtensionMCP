<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AltiumMcp.Server</RootNamespace>
    <AssemblyName>AltiumMcp.Server</AssemblyName>
    <RollForward>Major</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>MCP (stdio) server exposing Altium Designer read-only project data via the in-process bridge extension.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AltiumMcp.Contracts\AltiumMcp.Contracts.csproj" />
  </ItemGroup>

</Project>
